{
    "i18n": true,
    "type": "panel",
    "items": {
        "headerReplay": { "type": "header", "text": "headerReplay", "size": 3, "newLine": true },
        "historyInstance": {
            "type": "instance",
            "adapter": "_dataSources",
            "label": "historyInstance",
            "help": "historyInstance_help",
            "newLine": true,
            "xs": 12, "sm": 12, "md": 6, "lg": 4, "xl": 4
        },
        "days": {
            "type": "number",
            "label": "days",
            "help": "days_help",
            "min": 1, "max": 28,
            "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "jitter": {
            "type": "number",
            "label": "jitter",
            "help": "jitter_help",
            "min": 0, "max": 1800,
            "xs": 12, "sm": 6, "md": 3, "lg": 2, "xl": 2
        },
        "restore": {
            "type": "checkbox",
            "label": "restore",
            "newLine": true,
            "xs": 12, "sm": 12, "md": 6, "lg": 4, "xl": 4
        },
        "headerStates": { "type": "header", "text": "headerStates", "size": 3, "newLine": true },
        "states": {
            "type": "table",
            "help": "states_help",
            "newLine": true,
            "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12,
            "items": [
                { "type": "checkbox", "attr": "enabled", "title": "enabled", "width": "10%", "default": true },
                { "type": "objectId", "attr": "id", "title": "id", "width": "55%", "filter": false, "sort": true },
                { "type": "text", "attr": "name", "title": "name", "width": "35%", "filter": false }
            ]
        },
        "headerTrigger": { "type": "header", "text": "headerTrigger", "size": 3, "newLine": true },
        "triggerId": {
            "type": "objectId",
            "label": "triggerId",
            "help": "triggerId_help",
            "newLine": true,
            "xs": 12, "sm": 12, "md": 8, "lg": 6, "xl": 6
        },
        "triggerValue": {
            "type": "text",
            "label": "triggerValue",
            "help": "triggerValue_help",
            "hidden": "!data.triggerId",
            "xs": 12, "sm": 12, "md": 4, "lg": 3, "xl": 3
        }
    }
}
